)


remove_zero_var <- function(mat) {
  row_var <- apply(mat, 1, var, na.rm = TRUE)
  mat[row_var > 0, , drop = FALSE]
}

# ==============================================================================
# 3. CORE ANALYSIS FUNCTION
# ==============================================================================
analyze_dss_results <- function(dml_file_path, sex_group, g1_cond, g2_cond, bsseq_data, metadata, base_out) {
  
  comp_name <- paste0(g1_cond, "_vs_", g2_cond)
  group_label <- paste0(sex_group, "_", comp_name)
  message(paste("\n--- Analyzing:", toupper(group_label), "---"))
  
  # Directorios específicos para esta comparación
  comp_out <- file.path(base_out, sex_group, comp_name)
  dir.create(comp_out, showWarnings = FALSE, recursive = TRUE)
  dir.create(file.path(comp_out, "plots"), showWarnings = FALSE)
  dir.create(file.path(comp_out, "GO"), showWarnings = FALSE)
  
  # Load DML result
  dml_result <- readRDS(dml_file_path)
  
  # FILTER METADATA AND BSSEQ EXCLUSIVELY FOR THE TWO GROUPS
  group_meta <- metadata %>% filter(sex == sex_group & condition %in% c(g1_cond, g2_cond))
  group_sample_ids <- group_meta$id
  bsseq_group <- bsseq_data[, group_sample_ids]

  # Contrast-level metadata, prepended to every exported DMC/DMR row
  group1_samples <- group_meta$id[group_meta$condition == g1_cond]
  group2_samples <- group_meta$id[group_meta$condition == g2_cond]
  contrast_meta <- data.frame(
    sex              = sex_group,
    comparison       = comp_name,
    group1_condition = g1_cond,
    group2_condition = g2_cond,
    group1_samples   = paste(group1_samples, collapse = ";"),
    group2_samples   = paste(group2_samples, collapse = ";"),
    stringsAsFactors = FALSE
  )

  # --- 1. CALL DMCs & DMRs ---
  dmcs_all <- callDML(dml_result, delta = 0, p.threshold = 0.05)
  dmcs_filt <- callDML(dml_result, delta = dmc_delta, p.threshold = dmc_fdr)
  if(!is.null(dmcs_filt)) dmcs_filt <- dmcs_filt[dmcs_filt$fdr < dmc_fdr, ]
  
  dmrs_filt <- callDMR(dml_result, delta = dmr_delta, p.threshold = dmr_p_threshold, minlen = dmr_minlen, minCG = dmr_minCG)
  
  # Export raw tables
  if(!is.null(dmcs_filt) && nrow(dmcs_filt) > 0) write.table(dmcs_filt, file.path(comp_out, paste0("DMCs_filtered_", group_label, ".txt")), sep = "\t", quote = FALSE, row.names = FALSE)
  if(!is.null(dmrs_filt) && nrow(dmrs_filt) > 0) write.table(dmrs_filt, file.path(comp_out, paste0("DMRs_filtered_", group_label, ".txt")), sep = "\t", quote = FALSE, row.names = FALSE)
  
  if(is.null(dmrs_filt) && is.null(dmcs_filt)) {
    warning(paste("No significant DMCs or DMRs found for", group_label, "Skipping plots."))
    return(list(dmc_genes = character(0), dmr_genes = character(0)))
  }
  
  # --- 2. GRANGES PREP ---
  dmc_sig_gr <- GRanges()
  dmr_gr <- GRanges()
  
  if(!is.null(dmcs_filt) && nrow(dmcs_filt) > 0) {
    dmc_gr <- GRanges(seqnames = dmcs_all$chr, ranges = IRanges(start = dmcs_all$pos, width = 1), strand = "*", fdr = dmcs_all$fdr)
    dmc_sig_gr <- GRanges(seqnames = dmcs_filt$chr, ranges = IRanges(start = dmcs_filt$pos, width = 1), strand = "*", fdr = dmcs_filt$fdr)
  }
  
  if(!is.null(dmrs_filt) && nrow(dmrs_filt) > 0) {
    dmr_gr <- GRanges(seqnames = dmrs_filt$chr, ranges = IRanges(start = dmrs_filt$start, end = dmrs_filt$end), strand = "*", 
                      dmr_id = paste(dmrs_filt$chr, dmrs_filt$start, dmrs_filt$end, sep = ":"))
    
    # METHYLATION MATRIX FOR DMRs
    dmr_meth_matrix <- getMeth(bsseq_group, type = "raw", regions = dmr_gr, what = "perRegion")
    rownames(dmr_meth_matrix) <- dmr_gr$dmr_id
    colnames(dmr_meth_matrix) <- colnames(bsseq_group)
    write.csv(dmr_meth_matrix, file.path(comp_out, paste0("DMR_methylation_matrix_", group_label, ".csv")), quote = FALSE)

    # Companion sample metadata for the methylation matrix columns
    sample_meta_out <- group_meta[, c("id", "condition", "sex", "rep", "tissue")]
    colnames(sample_meta_out)[1] <- "sample_id"
    write.csv(sample_meta_out, file.path(comp_out, paste0("sample_metadata_", group_label, ".csv")), row.names = FALSE, quote = FALSE)
  }
  
  # --- 3. ANNOTATION ---
  annotate_and_format <- function(gr, name_label) {
    if(length(gr) == 0) return(data.frame())
    anno <- as.data.frame(annotatePeak(gr, TxDb = txdb, tssRegion = c(-2000, 2000), verbose = FALSE))
    anno$feature_category <- case_when(
      grepl("Promoter", anno$annotation) ~ "Promoter", grepl("Exon", anno$annotation) ~ "Exon",
      grepl("Intron", anno$annotation) ~ "Intron", grepl("UTR", anno$annotation) ~ "UTR",
      grepl("Downstream", anno$annotation) ~ "Downstream", grepl("TSS", anno$annotation) ~ "TSS",
      grepl("Intergenic", anno$annotation) ~ "Intergenic", TRUE ~ "Other"
    )
    df_final <- left_join(anno, gtf_meta_unique, by = c("geneId" = "gene_id"))
    write.table(df_final, file.path(comp_out, paste0(name_label, "_annotated_", group_label, ".txt")), sep = "\t", quote = FALSE, row.names = FALSE)
    return(df_final)
  }
  
  dmc_anno_df <- annotate_and_format(dmc_gr, "ALL_DMCs")
  dmc_sig_anno_df <- annotate_and_format(dmc_sig_gr, "DSS_sign_DMCs")
  dmr_anno_df <- annotate_and_format(dmr_gr, "DSS_DMRs")
  
  # --- 4. PLOTTING ---
  
  if(nrow(dmc_sig_anno_df) > 0) {
    # A. Pie Chart
    category_counts <- dmc_sig_anno_df %>% count(feature_category) %>% complete(feature_category = names(feature_colors), fill = list(n = 0)) %>%
      mutate(percentage = round(100 * n / sum(n), 1), legend_label = paste0(feature_category, " (", percentage, "%)"))
    
    pie_plot <- ggplot(category_counts, aes(x = "", y = n, fill = feature_category)) +
      geom_col(width = 1, color = "white") + coord_polar("y") +
      scale_fill_manual(values = feature_colors, labels = category_counts$legend_label) + theme_void() +
      labs(title = paste("Significant DMCs by Feature -", group_label), fill = "Category")
    ggsave(file.path(comp_out, paste0("plots/pie_chart_", group_label, ".png")), pie_plot, width = 8, height = 6, bg="white")
    
    # B. Volcano Plot
    dmcs_annotated <- merge(dmcs_all, dmc_anno_df[, c("start", "geneId")], by.x = "pos", by.y = "start", all.x = TRUE)
    dmcs_annotated$Gene <- ifelse(is.na(dmcs_annotated$geneId), paste0(dmcs_annotated$chr, "_", dmcs_annotated$pos), dmcs_annotated$geneId)
    
    dmcs_annotated <- dmcs_annotated %>% mutate(direction = case_when(
      diff > dmc_delta & fdr < dmc_fdr ~ "Hyper",
      diff < -dmc_delta & fdr < dmc_fdr ~ "Hypo",
      TRUE ~ "NotSig"
    ))
    
    top_dmcs <- dmcs_annotated %>% filter(fdr < dmc_fdr, !is.na(geneId)) %>% group_by(geneId) %>%
      slice_min(fdr, n = 1, with_ties = FALSE) %>% ungroup() %>% slice_min(fdr, n = 20, with_ties = FALSE)
    
    volcano <- ggplot(dmcs_annotated, aes(x = diff, y = -log10(fdr))) +
      geom_point(aes(color = direction), alpha = 0.6) + scale_color_manual(values = c("Hyper" = "#E64A19", "Hypo" = "#1976D2", "NotSig" = "grey")) +
      geom_vline(xintercept = c(-dmc_delta, dmc_delta), linetype = "dashed") + geom_hline(yintercept = -log10(dmc_fdr), linetype = "dashed") +
      geom_text_repel(data = top_dmcs, aes(label = Gene), size = 3, max.overlaps = 30) +
      theme_minimal() + labs(title = paste("Volcano Plot -", group_label), x = "Methylation Difference", y = "-log10(FDR)")
    ggsave(file.path(comp_out, paste0("plots/volcano_plot_", group_label, ".png")), volcano, width = 8, height = 6, bg="white")
    
    # C. Heatmap (Top 50 by Diff)
    dmcs_for_heatmap <- dmcs_annotated %>% filter(fdr < dmc_fdr, !is.na(geneId)) %>% group_by(geneId) %>%
      slice_max(abs(diff), n = 1, with_ties = FALSE) %>% ungroup() %>% slice_max(abs(diff), n = 50, with_ties = FALSE)
    
    if(nrow(dmcs_for_heatmap) > 2) {
      top_gr <- GRanges(seqnames = dmcs_for_heatmap$chr, ranges = IRanges(start = dmcs_for_heatmap$pos, width = 1))
      meth_mat_hm <- getMeth(bsseq_group, type = "raw", regions = top_gr, what = "perRegion")
      colnames(meth_mat_hm) <- colnames(bsseq_group)
      meth_mat_scaled <- t(scale(t(remove_zero_var(meth_mat_hm))))
      
      png(file.path(comp_out, paste0("plots/heatmap_top50_", group_label, ".png")), width = 800, height = 600)
      pheatmap(meth_mat_scaled, cluster_rows = TRUE, cluster_cols = TRUE, 
               annotation_col = group_meta[, "condition", drop=FALSE], 
               show_rownames = FALSE, main = paste("Top 50 Diff Sites -", group_label))
      dev.off()
    }
    
    # GO Exports
    genes_dmc <- na.omit(unique(dmc_sig_anno_df$geneId))
    writeLines(genes_dmc, file.path(comp_out, paste0("GO/genes_DMC_", group_label, ".txt")))
  } else { genes_dmc <- character(0) }
  
  if(nrow(dmr_anno_df) > 0) {
    genes_dmr <- na.omit(unique(dmr_anno_df$geneId))
    writeLines(genes_dmr, file.path(comp_out, paste0("GO/genes_DMR_", group_label, ".txt")))
  } else { genes_dmr <- character(0) }
  
  # Clear memory
  rm(bsseq_group, dmcs_all, dmcs_filt)
  gc(verbose = FALSE)
  
  return(list(dmc_genes = genes_dmc, dmr_genes = genes_dmr))
}

# ==============================================================================
# 4. EXECUTION LOOP
# ==============================================================================
message("\nStarting automated downstream pipeline...")

# Estructura para guardar los genes de cada comparación y usarlos en los Venn
gene_lists_for_venn <- list()

for (current_sex in sexes_to_test) {
  
  gene_lists_for_venn[[current_sex]] <- list()
  
  for (comp in comparisons_to_run) {
    g1_cond <- comp[1]
    g2_cond <- comp[2]
    comp_name <- paste0(g1_cond, "_vs_", g2_cond)
    
    # Locate the .rds file generated by the previous script.
    expected_rds <- file.path(work_dir, dss_res_dir, 
                              paste0("dml_result_", comp_name, "_", current_sex, ".rds"))
    
    if (file.exists(expected_rds)) {
      results <- analyze_dss_results(
        dml_file_path = expected_rds,
        sex_group = current_sex,
        g1_cond = g1_cond,
        g2_cond = g2_cond,
        bsseq_data = bsseq_obj,
        metadata = sample_info,
        base_out = output_dir
      )
      # Guardamos los genes significativos para el diagrama de Venn
      gene_lists_for_venn[[current_sex]][[comp_name]] <- results$dmc_genes
    } else {
      message(paste("Skipping", current_sex, comp_name, "- file not found:", expected_rds))
    }
  }
}

# ==============================================================================
# 5. VENN DIAGRAMS (3-Way by Sex)
# ==============================================================================
message("\nGenerating Venn Diagrams...")

for (current_sex in sexes_to_test) {
  # Only create a Venn diagram if all 3 comparisons exist for that sex.
  if (length(gene_lists_for_venn[[current_sex]]) == 3) {
    
    venn.diagram(
      x = list(
        "High vs Control" = gene_lists_for_venn[[current_sex]][["high_vs_control"]],
        "Low vs Control"  = gene_lists_for_venn[[current_sex]][["low_vs_control"]],
        "High vs Low"     = gene_lists_for_venn[[current_sex]][["high_vs_low"]]
      ),
      filename = file.path(output_dir, current_sex, paste0("Venn_DMC_Overlap_", current_sex, ".png")),
      imagetype = "png", height = 2000, width = 2000, resolution = 300,
      fill = c("#FF9999", "#9999FF", "#99FF99"), 
      cex = 1.5, fontface = "bold", cat.cex = 1.2, cat.default.pos = "outer",
      main = paste(toupper(current_sex), "- DMCs Overlap Across Conditions"), main.cex = 1.5
    )
    message(paste("Saved 3-way Venn diagram for:", current_sex))
  }
}

message("\nPipeline Finished Successfully!")
