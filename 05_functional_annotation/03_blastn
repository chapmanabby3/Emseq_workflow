###############################################################################
# READ DMR TABLE
###############################################################################

read_dmr_table <- function(file) {
  message("Reading: ", file)

  tbl <- read_delim(
    file,
    delim = ",",
    show_col_types = FALSE,
    na = c("", "NA", "NaN")
  )

  # If the file is tab-delimited despite having a .csv extension,
  # read it again using tab separation.
  if (ncol(tbl) == 1) {
    tbl <- read_delim(
      file,
      delim = "\t",
      show_col_types = FALSE,
      na = c("", "NA", "NaN")
    )
  }

  required_columns <- c("seqnames", "start", "end", "dmr_id")

  missing_columns <- setdiff(required_columns, colnames(tbl))

  if (length(missing_columns) > 0) {
    stop(
      "Missing required columns in ", file, ": ",
      paste(missing_columns, collapse = ", ")
    )
  }

  tbl
}

###############################################################################
# SELECT DMRs FOR blastn
###############################################################################
###i think this might need some more work/more decisions about this###


select_DMRs_for_blastn <- function(tbl) {

  tbl %>%
    mutate(
      seqnames = as.character(seqnames),
      start = as.integer(start),
      end = as.integer(end),

      no_swissprot_hit =
        is.na(sseqid) |
        sseqid == "" |
        sseqid == "NA",

###for now, we comment out unresolved locus filter
####this is because selecting DMRs from the table which have BOTH no sequence ID and unresolved locus is too strict,
###we may miss DMRs which still need to be defined.

   ###   unresolved_locus =
       # is.na(gene_symbol) |
       # gene_symbol == "" |
       # gene_symbol == "NA" |
       # grepl("^unassigned", geneId, ignore.case = TRUE),

      valid_coordinates =
        !is.na(seqnames) &
        !is.na(start) &
        !is.na(end) &
        start >= 1 &
        end >= start
    ) %>%
    filter(
      valid_coordinates,
      no_swissprot_hit
    )
}

###############################################################################
# CREATE REGION LIST FOR samtools faidx
###############################################################################

make_region_file <- function(tbl, region_file) {

  regions <- tbl %>%
    mutate(
      region = paste0(seqnames, ":", start, "-", end)
    ) %>%
    distinct(region) %>%
    pull(region)

  writeLines(regions, region_file)

  invisible(regions)
}

###############################################################################
# EXTRACT DMR DNA SEQUENCES
###############################################################################

extract_sequences <- function(region_file, fasta_file, output_fasta) {

  message("Extracting sequences from reference genome...")

  status <- system2(
    samtools_exe,
    args = c(
      "faidx",
      "--fai-idx", shQuote(genome_index),
      shQuote(fasta_file),
      "-r", shQuote(region_file)
    ),
    stdout = output_fasta
  )

  if (status != 0 || !file.exists(output_fasta)) {
    stop("Sequence extraction failed for: ", region_file)
  }

  invisible(output_fasta)
}

###############################################################################
# MAKE UNIQUE FASTA IDS THAT CAN BE LINKED BACK TO DMR TABLE
###############################################################################

rename_fasta_headers <- function(input_fasta, output_fasta, tbl) {

  fasta_lines <- readLines(input_fasta)

  header_indices <- which(startsWith(fasta_lines, ">"))

  if (length(header_indices) != nrow(tbl)) {
    warning(
      "Number of FASTA sequences does not equal number of selected DMRs. ",
      "Check for duplicate regions or missing scaffold names."
    )
  }

  dmr_ids <- make.unique(as.character(tbl$dmr_id))

  header_map <- tbl %>%
    mutate(
      query_id = dmr_ids,
      region = paste0(seqnames, ":", start, "-", end)
    ) %>%
    select(
      query_id,
      dmr_id,
      region,
      seqnames,
      start,
      end,
      geneId,
      feature_category
    )

  map_file <- paste0(output_fasta, ".metadata.tsv")

  write_tsv(header_map, map_file)

  current_header <- 0

  for (i in seq_along(fasta_lines)) {
    if (startsWith(fasta_lines[i], ">")) {
      current_header <- current_header + 1

      if (current_header <= length(dmr_ids)) {
        fasta_lines[i] <- paste0(">", dmr_ids[current_header])
      }
    }
  }

  writeLines(fasta_lines, output_fasta)

  invisible(header_map)
}

###############################################################################
# RUN blastn
###############################################################################
####these are parameters which need to be defined#########
###"-evalue", "#",
###"-max_target_seqs", "#",
###"-num_threads", "#"###
###may be best to begin with -max_target_seqs at 20 and later narrow down to 10####


run_blastn <- function(query_fasta, database, output_file) {

  message("Running blastn: ", query_fasta)

  blast_columns <- paste(
    "qseqid",
    "sseqid",
    "pident",
    "length",
    "mismatch",
    "gapopen",
    "qstart",
    "qend",
    "sstart",
    "send",
    "evalue",
    "bitscore",
    "qlen",
    "slen",
    sep = " "
  )

  status <- system2(
    blastn_exe,
    args = c(
      "-query", shQuote(query_fasta),
      "-db", shQuote(database),
      "-out", shQuote(output_file),
      "-outfmt", shQuote(paste("6", blast_columns)),
      "-evalue", "1e-10",
      "-max_target_seqs", "20",
      "-num_threads", "4"
    )
  )

  if (status != 0) {
    stop("blastn failed for: ", query_fasta)
  }

  invisible(output_file)
}

