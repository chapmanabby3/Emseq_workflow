##edited colors below to be more colorblind friendly##
##Okabe-Ito color pallette##

feature_colors <- c(
  "Promoter"    = "#E69F00",  # Gold/Orange
  "Exon"        = "#56B4E9",  # Soft Blue
  "Intron"      = "#009E73",  # Green
  "UTR"         = "#F0E442",  # Yellow
  "Downstream"  = "#0072B2",  # Dark Blue
  "TSS"         = "#D55E00",  # Dark Orange
  "Intergenic"  = "#CC79A7",  # Pink
