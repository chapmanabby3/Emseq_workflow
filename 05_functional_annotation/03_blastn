###############################################################################
# READ AND SUMMARIZE blastn RESULTS
###############################################################################

read_blastn_results <- function(blast_file) {

  blast_columns <- c(
    "qseqid",
    "sseqid",
    "pident",
    "length",
    "mismatch",
    "gapopen",
    "qstart",
    "qend",
    "sstart",
    "send",
    "evalue",
    "bitscore",
    "qlen",
    "slen"
  )

  if (!file.exists(blast_file) || file.info(blast_file)$size == 0) {
    return(tibble())
  }

  read_tsv(
    blast_file,
    col_names = blast_columns,
    show_col_types = FALSE
  ) %>%
    mutate(
      query_coverage = 100 * length / qlen,
      subject_coverage = 100 * length / slen
    ) %>%
    group_by(qseqid) %>%
    arrange(evalue, desc(bitscore), desc(query_coverage)) %>%
    slice(1) %>%
    ungroup()
}

###############################################################################
# PROCESS EACH COMPARISON
###############################################################################

for (i in seq_len(nrow(comparisons))) {

  comparison <- comparisons$comparison[i]
  prefix <- comparison
  dmr_file <- comparisons$dmr_file[i]
  dmr_output_file <- comparisons$dmr_output_file[i]

  message("\n==============================================")
  message("Processing: ", comparison)
  message("==============================================")

  dmr <- read_dmr_table(dmr_file)

  selected_dmr <- select_DMRs_for_blastn(dmr)

  message("Total DMRs: ", nrow(dmr))
  message("Selected for blastn: ", nrow(selected_dmr))

  if (nrow(selected_dmr) == 0) {
    warning("No DMRs selected for ", comparison)
    next
  }

  # Make unique query IDs
  selected_dmr <- selected_dmr %>%
    mutate(
      query_id = paste0(
        prefix, "__DMR_", row_number()
      ),
      region = paste0(seqnames, ":", start, "-", end)
    )

  region_file <- file.path(
    output_dir,
    paste0(prefix, "_regions.txt")
  )

  raw_fasta <- file.path(
    output_dir,
    paste0(prefix, "_raw_DMR_sequences.fa")
  )

  query_fasta <- file.path(
    output_dir,
    paste0(prefix, "_blastn_queries.fa")
  )

  blast_output <- file.path(
    output_dir,
    paste0(prefix, "_blastn_results.tsv")
  )

  selected_table <- file.path(
    output_dir,
    paste0(prefix, "_selected_DMRs.tsv")
  )

  annotated_output <- dmr_output_file
  
  # Write the selected DMR table
  write_tsv(selected_dmr, selected_table)

  # Write regions and extract DNA
  writeLines(selected_dmr$region, region_file)

  message("Extracting DNA sequences...")
  extract_status <- system(
    paste(
      shQuote(samtools_exe),
      "faidx",
      "--fai-idx",
      shQuote(genome_index),
      shQuote(genome_fasta),
      "-r",
      shQuote(region_file),
      ">",
      shQuote(raw_fasta)
    )
  )

  if (extract_status != 0) {
    stop("samtools sequence extraction failed.")
  }

  # Rename FASTA headers using query_id values
  raw_lines <- readLines(raw_fasta)
  header_positions <- which(startsWith(raw_lines, ">"))

  if (length(header_positions) != nrow(selected_dmr)) {
    stop(
      "The number of extracted sequences (",
      length(header_positions),
      ") does not equal the number of selected DMRs (",
      nrow(selected_dmr),
      "). Check scaffold names and coordinates."
    )
  }

  header_counter <- 0

  for (j in seq_along(raw_lines)) {
    if (startsWith(raw_lines[j], ">")) {
      header_counter <- header_counter + 1
      raw_lines[j] <- paste0(">", selected_dmr$query_id[header_counter])
    }
  }

  writeLines(raw_lines, query_fasta)

  query_metadata <- selected_dmr %>%
    select(
      query_id,
      dmr_id,
      seqnames,
      start,
      end,
      width,
      geneId,
      transcriptId,
      feature_category,
      gene_symbol,
      protein_id,
      sseqid
    )

  metadata_file <- file.path(
    output_dir,
    paste0(prefix, "_blastn_query_metadata.tsv")
  )

  write_tsv(query_metadata, metadata_file)

  # Run blastn
  run_blastn(
    query_fasta = query_fasta,
    database = blast_db,
    output_file = blast_output
  )

  # Read best BLAST hit per query
  best_hits <- read_blastn_results(blast_output)

  # Join BLAST results back to original selected DMRs
  final_table <- selected_dmr %>%
    left_join(
      best_hits,
      by = c("query_id" = "qseqid")
    )

  write_csv(final_table, annotated_output)

  message("Wrote:")
  message("  Query FASTA: ", query_fasta)
  message("  BLAST results: ", blast_output)
  message("  Final table: ", annotated_output)
  message("  Best hits: ", nrow(best_hits))
}

message("\nAll comparisons completed.")
